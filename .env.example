# Required in production. Generate SESSION_SECRET with a password manager or:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/daily-earner.sqlite
SESSION_SECRET=generate-a-new-random-secret

# Required for the Vercel serverless API. Keep the service role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used once to create the first administrator if it does not exist.
ADMIN_NAME=Your administrator name
ADMIN_PHONE=+2567XXXXXXXX
ADMIN_INITIAL_PASSWORD=choose-a-strong-password
ADMIN_TRADE_PASSWORD=000000

# Payment credentials are server-only. Never put these in VITE_* variables.
MARZPAY_BASIC_AUTH=your-marzpay-basic-auth-token
MARZPAY_WEBHOOK_SECRET=your-marzpay-webhook-secret
